#!/bin/bash
#~~~~~~~~~~
# Generated by cmake from simply-cpp's scripts/run.sh.in.
# Edit the template, not this copy: sc_bootstrap.cmake reports when this file has
# drifted, and -DSC_UPDATE_HELPERS=ON puts it back.
#
# Runs on the server, in the directory deploy.sh synced to.

module="sc-@SC_DEPLOY_NAME@"
version="@SC_VERSION@"
ubuntu_codename=$(lsb_release -sc)
build_directory="cmake-build-$ubuntu_codename"
apt -y install cmake clang-tidy ccache g++

pushd "/var/www/build/$module" || exit

if [ -f scripts/pre-build.sh ]; then
    echo "Running pre-build"
    ./scripts/pre-build.sh
else
    echo "No pre-build required"
fi

configure_build_test() {
    cmake -DCMAKE_BUILD_TYPE=Release -B "$build_directory" -S . && \
    cmake --build "$build_directory" -j 12 && \
    ctest --test-dir "$build_directory" --output-on-failure
}

# /var/www/build is shared across all build-* servers, and $build_directory is
# reused between deploys - if this host's toolchain/deps changed since it was
# last configured here, the cache can go stale and hide the real state. That
# includes things a plain build won't notice: find_file()/find_package() cache
# their result in CMakeCache.txt, so e.g. a model file that wasn't installable
# last time this was configured here stays "not found" (or the reverse) until
# something forces a re-search - a test is often the first thing to actually
# notice. One clean retry of configure+build+test recovers from that without
# needing to debug it by hand each time.
if ! configure_build_test; then
    echo "Build or test failed - cleaning $build_directory and retrying once in case its cache is stale for this host."
    rm -rf "$build_directory"
    configure_build_test || exit
fi

cmake --install $build_directory

pushd $build_directory || exit
rm -rf *.deb
cpack --config CPackConfig.cmake -G DEB
rm -rf *unknown*.deb
# Only the packages this run built go into this server's distribution. /var/www/build is shared
# by the build servers, so the shared debs folder can hold other modules' and other servers'
# packages too: included here, they went into the wrong distribution and went missing from
# their own (moved to processed before their server's run).
built_debs=()
for deb in "$PWD"/*.deb; do [ -f "$deb" ] && built_debs+=("$deb"); done
popd || exit

echo "Updating repository $module $version"
pushd /var/www/build/repo || exit
export GNUPGHOME=/var/www/build/signing
# The packages this run built, by their own names (an app's isn't its module's: html2pdf, not
# simply-cpp-html2pdf, which removing would have taken from the repository).
for deb in "${built_debs[@]}"; do
    reprepro remove $ubuntu_codename "$(dpkg-deb -f "$deb" Package)"
done
reprepro list $ubuntu_codename
install -d ../debs/processed
for deb in "${built_debs[@]}"; do
    echo "Loading $deb"
    reprepro includedeb $ubuntu_codename "$deb"
    cp "$deb" ../debs/processed/ # kept as a record
done
reprepro list $ubuntu_codename
popd || exit

popd || exit
